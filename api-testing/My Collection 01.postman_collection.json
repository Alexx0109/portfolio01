      "name": "New Request03",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус ответа — 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"responseCode равен 200\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.responseCode).to.eql(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Ответ содержит объект user\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"user\");\r",
              "});"
            ],
